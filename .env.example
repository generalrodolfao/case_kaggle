# ============================================================
# NYC Taxi Streaming Pipeline — variáveis de ambiente
# Copie para .env e ajuste os valores. Nunca commite .env.
# ============================================================

# === Kafka / Redpanda ===
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=taxi-rides
KAFKA_GROUP_ID=taxi-consumer

# === Producer ===
PRODUCER_BATCH_SIZE=1000
PRODUCER_RATE_LIMIT_PER_SEC=5000
# 0 = sem limite (processa o CSV completo)
PRODUCER_MAX_EVENTS=0

# === MinIO / S3 ===
S3_ENDPOINT=http://minio:9000
# Usado pelo dbt profiles.yml (sem protocolo)
S3_HOST_PORT=minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=datalake

# === Airflow ===
# Gere uma chave Fernet com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=81HqDtbqAywKSOumSha3BhWNOdQ26slT6K0YaZeZyPs=
AIRFLOW_SECRET_KEY=change-me-in-production
